# Copy this file to ".env.local" and paste your Anthropic API key after the "=".
# Get a key at https://console.anthropic.com  ->  Settings  ->  API Keys
# The key stays on the server. It is never sent to the browser.
# Never commit .env.local to git (it is already in .gitignore).

ANTHROPIC_API_KEY=

# Supabase project used to cache lookups against the city's open data.
# Server-side only — the client never talks to Supabase directly.
#
# Two keys, on purpose:
#   SUPABASE_ANON_KEY          reads. Supabase treats this key as public, and
#                              the database is configured to match: it can
#                              SELECT the cache tables and the ingested
#                              reports, and nothing else.
#   SUPABASE_SERVICE_ROLE_KEY  writes. Fills the caches. It bypasses every
#                              database restriction, so it must never be given
#                              a NEXT_PUBLIC_ prefix, logged, or committed.
#                              Both are under Supabase -> Project Settings ->
#                              API Keys.
#
# Leaving the service-role key blank is safe: the site still works, it just
# re-fetches from the city's services instead of reading its own cache.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Base URLs for the city's open services. Never hardcode these in source.
HEL_WFS_BASE_URL=https://kartta.hel.fi/ws/geoserver/avoindata/wfs
HEL_DECISIONS_BASE_URL=https://paatokset-elastic-proxy.api.hel.ninja

# Shared secret for the ingest-palaute Edge Function, used by
# `npm run backfill:palaute`. Set it to the same value stored on the function
# itself (Supabase -> Edge Functions -> ingest-palaute -> Secrets). Until that
# secret is set on the function, anyone holding the public anon key can
# trigger an ingestion run.
INGEST_SECRET=

# How many proxies/CDNs sit in front of the app in production. The rate
# limiter reads the caller's address this many hops from the end of
# X-Forwarded-For; getting it wrong in either direction weakens the limit.
# Default 1, which is right for a single reverse proxy or CDN.
TRUSTED_PROXY_HOPS=1
