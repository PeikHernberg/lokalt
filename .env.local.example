# Copy this file to ".env.local" and paste your Anthropic API key after the "=".
# Get a key at https://console.anthropic.com  ->  Settings  ->  API Keys
# The key stays on the server. It is never sent to the browser.
# Never commit .env.local to git (it is already in .gitignore).

ANTHROPIC_API_KEY=

# Supabase project used to cache lookups against the city's open data.
# Server-side only — the client never talks to Supabase directly.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Base URLs for the city's open services. Never hardcode these in source.
HEL_WFS_BASE_URL=https://kartta.hel.fi/ws/geoserver/avoindata/wfs
HEL_DECISIONS_BASE_URL=https://paatokset-elastic-proxy.api.hel.ninja
